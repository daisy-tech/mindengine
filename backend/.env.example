## ─── runtime ───
RUNTIME_KIND=web                 # web | worker
APP_TITLE=MindEngine API
LOG_LEVEL=INFO
PROMPT_TIMEZONE=Asia/Shanghai

## ─── database ───
# docker compose: hostname is `postgres`
DATABASE_URL=postgresql+asyncpg://mindengine:mindengine@localhost:5432/mindengine

## ─── redis ───
REDIS_URL=redis://localhost:6379/0
INTENT_CACHE_ENABLED=true

## ─── LLM ───
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-me
ENABLE_THINKING=false
INTENT_MODEL_TEMPERATURE=0

## ─── auth ───
JWT_SECRET=dev-secret-change-me
JWT_ALG=HS256
JWT_TTL_MIN=60

## ─── dev / safety (see 02-TDD §7) ───
DEV_MODE=false
ALLOW_DESTRUCTIVE_DEV=0

## ─── eval ───
EVAL_CHAT_REVIEWS_DIR=/app/eval/exports/reviews
EVAL_PASS_THRESHOLD=0.85
JUDGE_ENABLED=false
